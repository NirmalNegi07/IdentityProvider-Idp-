# Copy to .env (same folder) and fill in. .env is gitignored.
# Real environment variables override anything in this file.

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=idp_dev
DB_USER=root
DB_PASSWORD=

# ---- First administrator (created on first start if no admin exists) ----
ADMIN_EMAIL=admin@localhost.dev
ADMIN_PASSWORD=ChangeMe123

# ---- Optional ----
# Public URL of the IDP as browsers and apps see it (the frontend origin).
# Local default (appsettings.Development.json): http://localhost:5173
# Production: your domain, always https, e.g. https://auth.example.com
# IDP_ISSUER=https://auth.example.com
# Password protecting keys/signing.pfx and keys/encryption.pfx
# CERT_PASSWORD=
