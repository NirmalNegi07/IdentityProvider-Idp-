{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "server=localhost;port=3306;database=idp;user=idp;password=CHANGE_ME"
  },
  "Idp": {
    "Issuer": "https://auth.example.com",
    "AllowRegistration": true,
    "DefaultRole": "User",
    "Admin": {
      "Email": "admin@example.com",
      "Password": ""
    },
    "Certificates": {
      "SigningPath": "keys/signing.pfx",
      "EncryptionPath": "keys/encryption.pfx",
      "Password": null,
      "DataProtectionPath": "keys/dataprotection"
    },
    "Tokens": {
      "AccessTokenMinutes": 60,
      "IdentityTokenMinutes": 20,
      "RefreshTokenDays": 14,
      "AuthorizationCodeMinutes": 5
    },
    "CorsOrigins": []
  }
}
