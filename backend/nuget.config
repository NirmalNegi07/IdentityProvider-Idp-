<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Restore this solution's packages into a project-local folder instead of ~/.nuget/packages. -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
